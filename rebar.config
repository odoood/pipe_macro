{erl_opts, [debug_info]}.
{deps, []}.

{shell, [
    %% {config, "config/sys.config"},
    {apps, [pipe_macro]}
]}.

{hex, [{doc, ex_doc}]}.

{project_plugins, [rebar3_ex_doc]}.

{ex_doc, [
    {api_reference, false},
    {main, "README.md"},
    {extras, [
        "README.md",
        {'LICENSE.md', #{title => "License (GPLv3)"}}
    ]},
    {source_url, "https://github.com/odoood/pipe_macro"}
]}.
